{
  "name": "gaslacker",
  "version": "2.0.0",
  "private": true,
  "description": "Slack Web API client library for Google Apps Script.",
  "keywords": [
    "clasp",
    "gas",
    "google-apps-script"
  ],
  "homepage": "https://github.com/yhay81/GASlacker#readme",
  "bugs": {
    "url": "https://github.com/yhay81/GASlacker/issues"
  },
  "license": "MIT",
  "author": "yhay81",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhay81/GASlacker.git"
  },
  "main": "dist/bundle.js",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "catalog": "node scripts/generate-method-catalog.mjs",
    "catalog:check": "node scripts/generate-method-catalog.mjs --check",
    "parity": "node scripts/check-parity.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "build": "pnpm run catalog && pnpm run lint && pnpm run typecheck && vite build && tsc -p tsconfig.dts.json && node -e \"fs.copyFileSync('appsscript.json','dist/appsscript.json')\" && pnpm run test",
    "deploy": "pnpm run build && pnpm dlx @google/clasp@3 push",
    "fmt": "oxfmt --write ."
  },
  "devDependencies": {
    "@types/google-apps-script": "2.0.15",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
